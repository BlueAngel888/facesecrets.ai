modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY = "goog_cBAkvDkTvPOgiSfqzPCSoHOmgme"
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY = "appl_mfdfwjiCMVDOUHTeTjLorkllFlt"
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY = "test_wKTKvkjMbaLIUZFcpHxLhebwjVi"
REVENUECAT_APPLE_APP_STORE_APP_ID = "appeff5517ded"
