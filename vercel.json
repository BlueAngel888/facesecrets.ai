{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --filter @workspace/ancient-wisdom...",
  "buildCommand": "cd artifacts/ancient-wisdom && PORT=3000 BASE_PATH=/ pnpm run build",
  "outputDirectory": "artifacts/ancient-wisdom/dist/public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "artifacts/api-server/{*.py,sql/*.sql}",
      "excludeFiles": "{node_modules,artifacts/*/node_modules,artifacts/ancient-wisdom-mobile,artifacts/mockup-sandbox,attached_assets,screenshots,lib,scripts,.migration-backup}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/success", "destination": "/index.html" },
    { "source": "/cancel", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(robots.txt|sitemap.xml|llms.txt|llms-full.txt)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
